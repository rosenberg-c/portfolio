{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run css:generate && vp dev",
    "build": "vp run css:check && tsc -b && vp build",
    "css:generate": "tcm -a -p '**/*.module.css' src",
    "css:check": "tcm -a -l -p '**/*.module.css' src",
    "css:watch": "tcm -a -w -p '**/*.module.css' src",
    "lint": "vp lint",
    "preview": "vp preview"
  },
  "dependencies": {
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "typed-css-modules": "^0.9.1",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
